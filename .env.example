POSTGRES_USER=contest_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=contest_db
DATABASE_URL=postgresql+asyncpg://contest_user:change_me@db:5432/contest_db
SYNC_DATABASE_URL=postgresql+psycopg://contest_user:change_me@db:5432/contest_db

REDIS_URL=redis://redis:6379/0

# Generate a random secret of at least 32 characters; do not commit real secrets.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_MB=64
SANDBOX_COMPILE_TIMEOUT_S=10
SANDBOX_MAX_OUTPUT_BYTES=65536
JUDGE_MAX_ATTEMPTS=3
JUDGE_STALE_TIMEOUT_S=300

# Daily database archives older than this many days are removed.
BACKUP_RETENTION_DAYS=14

# Delivered or failed Telegram notifications older than this many days are removed.
NOTIFICATION_RETENTION_DAYS=30

# Optional GitHub OAuth App. Set these in your local .env to enable GitHub sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
GITHUB_FRONTEND_URL=http://localhost:5173/auth/callback

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
